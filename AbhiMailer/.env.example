# Mail Mania environment — placeholders only, never commit secrets.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PORT=3100
HOST=127.0.0.1
# 32+ byte secret for SMTP credential encryption (AES-256-GCM). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_KEY=
# Max send attempts per message (initial + retries). Default 3 attempts = 2 retries.
MAX_RETRIES=2
# Worker poll interval in ms
WORKER_POLL_MS=1000
# Opt-in live SMTP test. Normal suite never runs it unless =1.
ABHIMAILER_LIVE_ACCEPT=
# Live test knobs (only used when ABHIMAILER_LIVE_ACCEPT=1)
LIVE_SMTP_HOST=
LIVE_SMTP_PORT=
LIVE_SMTP_SECURITY=STARTTLS
LIVE_SMTP_USER=
LIVE_SMTP_PASS=
LIVE_SMTP_FROM=
LIVE_SMTP_TO=
