{
  "name": "mail-mania",
  "version": "1.0.0",
  "private": true,
  "description": "Mail Mania — local-first self-hosted email campaign platform (SMTP + Supabase Postgres)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:server\" \"npm run dev:ui\"",
    "dev:server": "tsx watch src/api/server.ts",
    "dev:ui": "vite --config frontend/vite.config.ts",
    "build": "npm run build:server && npm run build:ui",
    "build:server": "tsc -p tsconfig.json",
    "build:ui": "vite build --config frontend/vite.config.ts",
    "start": "node dist/src/index.js",
    "worker": "node dist/src/worker/run.js",
    "mailer": "node dist/src/cli/mailer.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:live": "ABHIMAILER_LIVE_ACCEPT=1 vitest run tests/integration/live-smtp.test.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "cors": "^2.8.5",
    "csv-parse": "^5.5.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "multer": "^2.4.0",
    "nodemailer": "^6.9.14",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sanitize-html": "^2.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.7.4",
    "@types/nodemailer": "^6.4.16",
    "@types/sanitize-html": "^2.11.0",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.1",
    "smtp-server": "^3.9.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
