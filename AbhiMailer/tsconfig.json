{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "outDir": "dist",
    "rootDir": ".",
    "types": ["node"],
    "noUncheckedIndexedAccess": false
  },
  "include": ["src/**/*", "tests/**/*", "vitest.config.ts", "frontend/vite.config.ts"],
  "exclude": ["node_modules", "dist", "frontend/dist", "frontend/node_modules"]
}
